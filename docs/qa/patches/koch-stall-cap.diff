+def koch_stall_ch(l_over_g2: float, re: float, eps_over_g: float = 0.0) -> float:
+    """Stalling static-pressure-rise coefficient (Koch 1981 form): falls with diffusion length / exit
+    passage width L/g2, knocked down at low Re and by tip clearance. Approximate, see KOCH_CH_SCALE."""
+    x = min(max(float(l_over_g2), 0.1), 3.0)
+    ch = min(0.42 * x ** -0.33, 0.65)
+    ch *= min(1.0, (max(float(re), 1.0e4) / 1.3e5) ** 0.1)
+    ch *= max(0.6, 1.0 - 1.5 * float(eps_over_g))
+    return ch
+
