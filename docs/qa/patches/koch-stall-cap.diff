+def _camber_angle_rad(max_camber: float, camber_pos: float = 0.4) -> float:
+    """NACA-4 mean-line camber angle (LE + TE slopes)."""
+    p = min(max(float(camber_pos), 0.1), 0.9)
+    return math.atan(2.0 * max_camber / p) + math.atan(2.0 * max_camber / (1.0 - p))
+
