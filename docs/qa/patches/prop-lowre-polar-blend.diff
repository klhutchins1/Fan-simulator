+def _low_re_blend(alpha_rad: float, camber: float, re: float, thickness: float):
+    """Smoothstep(log Re) blend of the analytic polar (at Re) into the lowest table (at Re_lo)."""
+    from fansim.propeller.polars import lowest_table_re, section_table
+
+    if not math.isfinite(re) or re <= 0.0:
+        return None
+    re_lo = lowest_table_re(camber, thickness)
+    if re_lo is None or re >= re_lo:
+        return None
+    re_a = re_lo / LOW_RE_BLEND_RATIO
+    if re <= re_a:
+        return None
+    hi = section_table(alpha_rad, camber, re_lo, thickness=thickness)
+    if hi is None:
+        return None
+    lo = _analytic_section(alpha_rad, camber, re)
+    x = (math.log10(re) - math.log10(re_a)) / (math.log10(re_lo) - math.log10(re_a))
+    w = x * x * (3.0 - 2.0 * x)
+    cl = w * hi[0] + (1.0 - w) * lo[0]
+    cd = w * hi[1] + (1.0 - w) * lo[1]
+    stalled = hi[2] if w >= 0.5 else lo[2]
+    cap = w * hi[3] + (1.0 - w) * lo[3]
+    return cl, cd, stalled, cap
+
