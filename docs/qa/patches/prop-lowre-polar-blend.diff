diff --git a/tests/test_prop_lowre_blend.py b/tests/test_prop_lowre_blend.py
new file mode 100644
index 0000000..f3d096d
--- /dev/null
+++ b/tests/test_prop_lowre_blend.py
@@ -0,0 +1,33 @@
+"""QA-12: prop BEMT blends the analytic low-Re polar into the lowest table (Re 4e4) instead of switching."""
+from __future__ import annotations
+
+import math
+
+import pytest
+
+from fansim.propeller.bemt import LOW_RE_BLEND_RATIO, _analytic_section, _cl_cd, _section_aero
+from fansim.propeller.polars import lowest_table_re, section_table
+
+CAM, TH = 0.04, 0.0633
+
+
+@pytest.mark.parametrize("a_deg", [0.0, 4.0, 8.0])
+def test_no_jump_at_lowest_table(a_deg):
+    a = math.radians(a_deg)
+    lo = _section_aero(a, CAM, re=39_999.0, thickness=TH, low_re_blend=True)
+    hi = _section_aero(a, CAM, re=40_000.0, thickness=TH, low_re_blend=True)
+    assert lo[0] == pytest.approx(hi[0], rel=0.01) and lo[1] == pytest.approx(hi[1], rel=0.01)
+
+
+def test_blend_end_points_and_fan_path_unchanged():
+    re_lo = lowest_table_re(CAM, TH)
+    assert re_lo == pytest.approx(4.0e4)
+    a = math.radians(4.0)
+    re_a = re_lo / LOW_RE_BLEND_RATIO
+    assert _section_aero(a, CAM, re=re_a, thickness=TH, low_re_blend=True) == _analytic_section(a, CAM, re_a)
+    mid = _section_aero(a, CAM, re=math.sqrt(re_a * re_lo), thickness=TH, low_re_blend=True)
+    t, f = section_table(a, CAM, re_lo, thickness=TH), _analytic_section(a, CAM, math.sqrt(re_a * re_lo))
+    assert min(t[0], f[0]) <= mid[0] <= max(t[0], f[0])
+    # default (fan BEM `_cl_cd`) keeps the old hard switch
+    assert _section_aero(a, CAM, re=30_000.0, thickness=TH)[:2] == _analytic_section(a, CAM, 30_000.0)[:2]
+    assert _cl_cd(a, CAM, re=30_000.0) == pytest.approx(_analytic_section(a, CAM, 30_000.0)[:2])
