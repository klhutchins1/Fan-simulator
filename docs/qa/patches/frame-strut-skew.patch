@@ -0,0 +1,47 @@
+import math
+
+import pytest
+
+from fansim.cfd.domain import MM_TO_M, rig_for_impeller
+from fansim.cfd.frame import STRUT_WALL_INSET_MM, build_frame_solid
+from fansim.geometry.blade import BladeParams
+
+
+def _rig():
+    p = BladeParams()
+    return p, rig_for_impeller(p, tip_gap_mm=0.5)
+
+
+def test_zero_skew_is_unchanged():
+    p, rig = _rig()
+    a = build_frame_solid(p, rig)
+    b = build_frame_solid(p, rig, strut_skew_deg=0.0)
+    assert abs(a.Volume() - b.Volume()) < 1e-9
+
+
+@pytest.mark.parametrize("skew", [-60.0, -35.0, 35.0, 60.0])
+def test_skewed_frame_one_solid_inside_wall(skew):
+    p, rig = _rig()
+    s = build_frame_solid(p, rig, strut_skew_deg=skew)
+    assert len(s.Solids()) == 1
+    outer_r = rig.duct_radius / MM_TO_M - STRUT_WALL_INSET_MM
+    bb = s.BoundingBox()
+    assert max(abs(bb.xmin), abs(bb.xmax), abs(bb.ymin), abs(bb.ymax)) <= outer_r + 1e-3
+    # longer bars than radial: more volume, by roughly the skew path factor
+    assert s.Volume() > build_frame_solid(p, rig).Volume()
+
+
+def test_skew_sign_follows_rotor_spin():
+    p, rig = _rig()
+    s = build_frame_solid(p, rig, strut_skew_deg=-35.0)  # counter-rotation
+    # strut 0 starts on +X; for spin=-1 (CW seen from +Z) counter-rotation moves its outer end to +Y
+    outer_r = rig.duct_radius / MM_TO_M - STRUT_WALL_INSET_MM
+    vs = [v.toTuple() for v in s.Vertices()]
+    near_wall = [v for v in vs if math.hypot(v[0], v[1]) > outer_r - 0.5 and v[0] > 0 and abs(v[1]) < outer_r * 0.8]
+    assert near_wall and all(v[1] > 0 for v in near_wall) == (rig.spin < 0)
+
+
+def test_skew_out_of_range():
+    p, rig = _rig()
+    with pytest.raises(ValueError):
+        build_frame_solid(p, rig, strut_skew_deg=80.0)
