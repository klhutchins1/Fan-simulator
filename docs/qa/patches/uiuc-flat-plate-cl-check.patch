+"""Lead #23: UIUC Vol 5 flat-plate Cl@Re≈40k sanity (Cl+Cm only; not a BEM polar)."""
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+CSV = Path(__file__).resolve().parents[1] / "docs" / "qa" / "data" / "uiuc_flat_plate_re4e4_clcm.csv"
+
+# Pre-registered known points from fp_baseline_lift.dat Re≈40021 upsweep
+KNOWN = {
+    2.10: 0.22,
+    4.13: 0.50,
+    6.13: 0.71,
+    8.15: 0.77,
+}
+
+
+def _load():
+    rows = []
+    for line in CSV.read_text().splitlines():
+        if not line or line.startswith("#") or line.startswith("alpha"):
+            continue
+        a, cl, cm = line.split(",")
+        rows.append((float(a), float(cl), float(cm)))
+    return rows
+
+
+@pytest.mark.skipif(not CSV.is_file(), reason="UIUC flat-plate Cl table not vendored yet")
+def test_uiuc_flat_plate_cl_known_points():
+    rows = _load()
+    assert len(rows) >= 8
+    by_a = {round(a, 2): cl for a, cl, _ in rows}
+    for a, cl in KNOWN.items():
+        assert a in by_a, f"missing alpha {a}"
+        assert abs(by_a[a] - cl) < 0.02
+    # rising Cl 2→6
+    assert by_a[6.13] > by_a[2.10] > 0.0
+
+
+@pytest.mark.skipif(not CSV.is_file(), reason="UIUC flat-plate Cl table not vendored yet")
+def test_uiuc_notice_present():
+    notice = CSV.parent / "UIUC_LSAT_NOTICE.txt"
+    assert notice.is_file()
+    text = notice.read_text()
+    assert "UIUC" in text
+    assert "attribution" in text.lower() or "commercial" in text.lower()
