+# --- OPT-IN "axial_force" pressure accounting (QA-4), ``pressure_model="axial_force"`` ---
+# Static rise = the blades' AXIAL force per unit annulus area, B·½ρW1²c·(cl·cosφ − cd·sinφ), with the
+# polar extended past stall (Viterna-Corrigan) and W1 the INLET relative velocity (cascade practice:
+# loading referenced to the inlet dynamic head). Blade drag and negative lift now LOWER the pressure,
+# so paddles / reversed blades no longer score as fans. Two EMPIRICAL buckets, tuned on the Stock
+# 7-station recipe's free CFM + shut-off only (60.1 CFM / 22.9 Pa datasheet; 2 knobs for 2 targets,
+# so Stock agreement is a fit, not validation). See research notes axial-force-pressure-accounting.md.
+PRESSURE_MODELS = ("euler", "axial_force")
+AX_SLIP = 0.65                # deviation / under-turning factor on the axial force (cf. SLIP = 0.71)
+AX_K_FRICTION = 1.9           # friction/secondary static loss ~ K * axial dynamic head (cf. K_FRICTION)
+CD_90 = 1.8                   # flat-plate drag at 90 deg incidence (literature ~1.2-2.0; fixed, not tuned)
+
+
+def _viterna(cl_s: float, cd_s: float, a_s: float, a: float) -> tuple[float, float]:
+    """Viterna-Corrigan post-stall cl/cd at incidence ``a`` (rad), blended from the stall point a_s."""
+    b1 = CD_90
+    a2 = (cl_s - b1 * math.sin(a_s) * math.cos(a_s)) * math.sin(a_s) / max(math.cos(a_s) ** 2, 1e-6)
+    b2 = (cd_s - b1 * math.sin(a_s) ** 2) / max(math.cos(a_s), 1e-6)
+    ca = max(abs(math.cos(a)), 1e-3)
+    sa = math.sin(a)
+    cl = 0.5 * b1 * math.sin(2.0 * a) + a2 * ca * ca / max(abs(sa), 1e-3) * math.copysign(1.0, sa)
+    cd = b1 * sa * sa + b2 * ca
+    return cl, max(cd, cd_s)
+
+
+def _cl_cd_post_stall(alpha: float, camber: float, re: float) -> tuple[float, float]:
+    """Shared low-Re polar inside its stall band, Viterna-Corrigan outside it. (The table polar
+    clamps cl/cd at its edges, so a 60-90 deg paddle would otherwise keep cl = 0.77, cd = 0.10.)"""
+    stall = math.radians(max(8.0, min(15.0, 10.0 + 3.0 * math.log10(max(re, 5000.0) / 20000.0))))
+    if -stall <= alpha <= stall:
+        return _cl_cd(alpha, camber, re=re)
+    edge = stall if alpha > stall else -stall
+    cl_s, cd_s = _cl_cd(edge, camber, re=re)
+    return _viterna(cl_s, cd_s, edge, alpha)
+
+
+def _euler_polar(alpha: float, camber: float, re: float) -> tuple[float, float]:
+    return _cl_cd(alpha, camber, re=re)
+
 
