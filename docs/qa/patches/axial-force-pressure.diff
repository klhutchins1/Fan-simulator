+# --- opt-in axial-force pressure accounting (QA-4) -------------------------------------------
+import copy
+
+import pytest
+
+from fansim.geometry.config import load_blade_params
+
+_AX = "axial_force"
+
+
+def _stock7():
+    return load_blade_params("config/problems/a12x25_reference.yaml")
+
+
+def _restagger(p, deg):
+    q = copy.deepcopy(p)
+    for s in q.stations:
+        s.stagger_deg = deg
+    return q
+
+
+def test_default_pressure_model_is_euler_and_unchanged():
+    p = _stock7()
+    a = pq_curve(p, 2000.0)
+    b = pq_curve(p, 2000.0, pressure_model="euler")
+    assert a == b
+    assert a.free_delivery_cfm == pytest.approx(58.2, abs=0.05)   # pre-patch Stock numbers
+    assert a.shutoff_dp_pa == pytest.approx(38.87, abs=0.01)
+
+
+def test_unknown_pressure_model_rejected():
+    with pytest.raises(ValueError):
+        operating_point(_stock7(), 2000.0, 0.02, pressure_model="bogus")
+
+
+def test_axial_force_stock_calibration():
+    """Rule (a): Stock 7-station within 60.1 CFM +/-10 % and 22.9 Pa +/-25 % (datasheet)."""
+    c = pq_curve(_stock7(), 2000.0, pressure_model=_AX)
+    assert c.free_status == "crossed"
+    assert 54.1 <= c.free_delivery_cfm <= 66.1
+    assert 17.2 <= c.shutoff_dp_pa <= 28.6
+
+
+@pytest.mark.parametrize("stagger", [89.0, -45.0, -60.0])
+def test_axial_force_paddle_and_reversed_score_bad(stagger):
+    """Rule (b): a paddle or a wrong-hand blade must not look like a fan."""
+    stock = pq_curve(_stock7(), 2000.0, pressure_model=_AX)
+    c = pq_curve(_restagger(_stock7(), stagger), 2000.0, pressure_model=_AX)
+    assert c.free_status == "no_rise" or (
+        c.free_delivery_cfm < 0.5 * stock.free_delivery_cfm
+        and c.peak_efficiency < 0.5 * stock.peak_efficiency)
+
+
+def test_axial_force_reversed_blade_gives_negative_pressure():
+    pt = operating_point(_restagger(_stock7(), -45.0), 2000.0, 0.005, pressure_model=_AX)
+    assert pt.dp_static_pa < 0.0
+
+
+def test_axial_force_zero_blades_no_crash():
+    c = pq_curve(BladeParams(n_blades=0), 2000.0, pressure_model=_AX)
+    assert c.free_delivery_cfm == 0.0
+    pt = operating_point(BladeParams(n_blades=0), 2000.0, 0.02, pressure_model=_AX)
+    assert pt.dp_static_pa <= 0.0
+
+
+def test_axial_force_static_air_power_below_shaft_power():
+    c = pq_curve(_stock7(), 2000.0, pressure_model=_AX)
+    assert all(0.0 <= p.efficiency < 1.0 for p in c.points)
