+# today's single NACA4 until the piecewise builder lands. Use rules, not Kim's absolute angles
+# (industrial wall fan, hub ratio 0.41). Avoid US8333559B2 tip-lean stacking geometry (Active).
+STATOR_LINEAR_EXIT_FRAC = 0.30
 
 
 def n_stator_vanes(params: BladeParams, n_extra: int | None = None) -> int:
@@ -66,9 +71,19 @@ def build_stator_solid(
